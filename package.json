{
  "name": "gomentor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A desktop Go (围棋) AI learning platform: KataGo analysis with an LLM coaching layer",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -F @gomentor/desktop dev",
    "build": "pnpm -r --filter=!@gomentor/web build",
    "package": "pnpm -F @gomentor/desktop package",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm typecheck:tools && pnpm -r typecheck",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm -F @gomentor/desktop e2e",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:trellis": "git diff --exit-code -- .trellis .claude .codex .qoder .agents AGENTS.md",
    "fetch:katago": "tsx scripts/fetch-katago.ts",
    "fetch:weights": "tsx scripts/fetch-weights.ts",
    "make:icon": "tsx scripts/make-icon.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
