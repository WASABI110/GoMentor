{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // Tests are checked as ESM, unlike `tsconfig.node.json`, which sets
    // `module: CommonJS` because the main process *bundles* to CJS for Electron.
    // That target is a property of the shipped bundle, not of these files: vitest
    // loads the test files as ES modules and transpiles them with esbuild.
    //
    // The two settings are not merely different, they are incompatible. Mocking
    // `electron` requires the module under test to be imported *after*
    // `vi.mock(...)` runs, which means top-level `await import(...)` — and that is
    // an error under `module: CommonJS` (TS1378). Checking the tests against the
    // main process's module format made the only correct way to write the test
    // unrepresentable, so the tests get their own project.
    //
    // `noEmit` for the same reason as the sibling configs: nothing builds from
    // tsc, and `composite` would demand every input sit under `rootDir` while
    // these files import sibling packages through `paths`.
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@gomentor/shared": ["../../packages/shared/src/index.ts"],
      "@gomentor/shared/*": ["../../packages/shared/src/*"],
      "@gomentor/core": ["../../packages/core/src/index.ts"],
      "@gomentor/core/*": ["../../packages/core/src/*"],
      "@main/*": ["./src/main/*"]
    }
  },
  // e2e is Playwright's, and it needs `DOM` in `lib` for the `page.evaluate`
  // callbacks — see `tsconfig.e2e.json`, which checks those files.
  //
  // `test/renderer/**` is excluded for the mirror-image reason: those tests
  // exercise renderer modules that reach `window.gomentor`, so they need `DOM`,
  // which this project deliberately lacks — main has no `window` at runtime and a
  // main-process test referencing one must not compile. See
  // `tsconfig.renderer-test.json`.
  //
  // `scripts/**` runs under tsx like the tests (ESM — the benchmark needs
  // `import.meta.url`), which is why it does not join `tsconfig.node.json`'s
  // CJS project.
  "include": ["test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["test/e2e/**", "test/renderer/**"]
}
