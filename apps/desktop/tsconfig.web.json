{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "outDir": "./out-types/web",
    "baseUrl": ".",
    "paths": {
      "@gomentor/shared": ["../../packages/shared/src/index.ts"],
      "@gomentor/shared/*": ["../../packages/shared/src/*"],
      "@gomentor/core": ["../../packages/core/src/index.ts"],
      "@gomentor/core/*": ["../../packages/core/src/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/preload/*.d.ts"]
}
