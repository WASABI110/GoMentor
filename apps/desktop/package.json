{
  "name": "@gomentor/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "GoMentor desktop application",
  "author": "GoMentor contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/WASABI110/GoMentor.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.renderer-test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "package": "electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --config electron-builder.yml",
    "e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@gomentor/core": "workspace:*",
    "@gomentor/shared": "workspace:*",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "i18next": "^24.2.1",
    "react-i18next": "^15.4.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  }
}
