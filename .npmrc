# electron-builder needs to resolve these from a flat-ish layout when packaging.
# Without the hoist patterns, packaged builds silently omit dependencies —
# a successful `pnpm dev` does NOT catch this. See implement.md §Risky files.
node-linker=hoisted
public-hoist-pattern[]=*electron*
public-hoist-pattern[]=*builder*

# Electron downloads its binary from a mirror; keep it explicit so CI is reproducible.
strict-peer-dependencies=false
auto-install-peers=true
